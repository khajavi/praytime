---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'praytime — Islamic prayer times for Python',
  description = 'Zero-dependency Islamic prayer times calculator — a faithful Python port of zarrabi/praytime (Fajr, Sunrise, Dhuhr, Asr, Sunset, Maghrib, Isha, Midnight).',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const favicon = `${base}${base.endsWith('/') ? '' : '/'}favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#documentation">Skip to documentation</a>
    <slot />
  </body>
</html>
